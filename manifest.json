{
  "manifest_version": 3,
  "name": "Layered Cinema",
  "version": "0.1.0",
  "description": "Injects content into YouTube",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_end"
    }
  ]
}
